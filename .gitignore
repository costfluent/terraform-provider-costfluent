# Editor/IDE
.idea/

# Binaries. The provider binary is anchored with a leading slash: unanchored, the pattern also
# matches the cmd/terraform-provider-costfluent package directory, and git then quietly declines
# to commit that source.
*.exe
*.exe~
*.dll
*.so
*.dylib
/terraform-provider-costfluent

# Test binary and coverage
*.test
*.out
coverage.*

# goreleaser output
dist/

# Local Terraform state from trying the examples
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
crash.log
crash.*.log

# Go workspace
go.work
go.work.sum

# env file
.env
